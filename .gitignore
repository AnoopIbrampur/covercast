.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store

# Kaggle's Recruit data is redistributable only under the competition rules,
# so it is never committed. Fetch it yourself (see README) into artifacts/raw/.
artifacts/raw/
artifacts/synthetic/

# Real-data predictions carry Recruit's visitor counts, which the competition
# rules don't allow redistributing. Summaries and figures are fine.
artifacts/results/recruit*/predictions.csv.gz
artifacts/results/recruit*/*/schedules.csv.gz
artifacts/results/site_recruit/

# Same page without the document shell, only used for publishing as an Artifact.
site/body.html
